[Unit]
Description=Check for a new Maximum Mathematics build and publish it
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/srv/maximum-mathematics/bin/poll-and-publish.sh

# This service only ever needs to read and write its own directory tree.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/maximum-mathematics
