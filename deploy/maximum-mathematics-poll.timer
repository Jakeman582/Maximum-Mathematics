[Unit]
Description=Run the Maximum Mathematics publish check periodically (safety net)

[Timer]
OnBootSec=2min
# The webhook (maximum-mathematics-webhook.service) is the primary trigger —
# this timer exists only to catch a missed or failed webhook delivery, so a
# push eventually gets published even if that happens. 20 minutes is fine for
# a fallback; there's no reason for it to run often.
OnUnitActiveSec=20min
AccuracySec=1min

[Install]
WantedBy=timers.target
