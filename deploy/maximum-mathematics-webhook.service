[Unit]
Description=Webhook listener that triggers a Maximum Mathematics publish check on push
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy

# Holds WEBHOOK_SECRET=... and lives outside the repository, mode 0600, so the
# shared secret is never committed. hooks.json reads it via -template.
EnvironmentFile=/etc/maximum-mathematics/webhook.env

# Bound to the loopback interface only: nginx terminates TLS and proxies to
# it, so the listener is never reachable from the internet directly.
ExecStart=/usr/local/bin/webhook \
  -hooks /srv/maximum-mathematics/bin/hooks.json \
  -template \
  -ip 127.0.0.1 \
  -port 9000

Restart=on-failure
RestartSec=5

# This service, and whatever it invokes (poll-and-publish.sh), only ever
# needs to read and write its own directory tree.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/maximum-mathematics

[Install]
WantedBy=multi-user.target
